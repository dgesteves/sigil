{
  "name": "tally-api",
  "version": "2.3.0",
  "private": true,
  "description": "Counts things for the Northwind dashboards.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.ts",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "6.0.3"
  }
}
