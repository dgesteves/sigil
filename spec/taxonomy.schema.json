{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sigil": {
      "type": "number",
      "const": 1
    },
    "technologies": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "language",
              "runtime",
              "framework",
              "library",
              "database",
              "platform",
              "infrastructure",
              "tool",
              "ai-provider",
              "ai-framework",
              "protocol",
              "practice"
            ]
          },
          "parent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "detect": {
            "type": "object",
            "properties": {
              "npm": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "pypi": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "cargo": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "go": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "maven": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "nuget": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "composer": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "gem": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "pub": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "hex": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sigil",
    "technologies"
  ],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/dgesteves/sigil/main/spec/taxonomy.schema.json",
  "title": "Sigil taxonomy (spec 1.0)"
}
