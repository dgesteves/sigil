{
  "name": "sigil-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
    "test": "pnpm -r --filter ./packages/* test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "sigil": "node packages/sigil/dist/cli.js",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm sigil validate catalog"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3"
  }
}
