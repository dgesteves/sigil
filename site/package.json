{
  "name": "sigil-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Sigil observatory: every agent capability, proven.",
  "scripts": {
    "dev": "pnpm --dir ../packages/sigil build && next dev --port 4317",
    "build": "pnpm --dir ../packages/sigil build && next build",
    "start": "next start --port 4317",
    "typecheck": "pnpm --dir ../packages/sigil build && next typegen && tsc --noEmit",
    "demo": "pnpm --dir ../packages/sigil build && node scripts/make-demo.mjs",
    "test": "pnpm --dir ../packages/sigil build && vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sigil": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
